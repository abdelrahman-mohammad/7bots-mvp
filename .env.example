# Postgres container
POSTGRES_DB=sevenbots
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_APP_USER=app
POSTGRES_APP_PASSWORD=password

# Application connection
DATABASE_URL=postgresql+psycopg://app:password@localhost:5432/sevenbots

# GitHub model repo
GITHUB_TOKEN=
GITHUB_MODEL_REPO=abdelrahman-mohammad/7bots-archimate

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="7bots-mvp"

# Anthropic
ANTHROPIC_API_KEY=
